# macOS metadata and editor scratch files
.DS_Store
._*
*~
*.swp
*.swo
*.tmp

# Local builds, review reports, logs, and Python caches
/build/
*.log
__pycache__/
*.py[cod]

# KiCad local preferences, caches, locks, autosaves, and automatic backups
*.kicad_prl
fp-info-cache
~*.lck
_autosave-*
*.kicad_*-bak
*-backups/

# Manufacturing intermediates; keep the existing packaged release files
/kicad/**/jlcpcb/gerber/
/kicad/**/jlcpcb/project.db
/kicad/**/production/backups/
/kicad/**/production/netlist.ipc

# FreeCAD automatic backups, local revision copies, and generated validation
# Keep the current FCStd model, STEP/STL exports, and documented previews.
*.FCBak
*.FCStd[0-9]
/box/cad/revisions/
/box/cad/validation.json
